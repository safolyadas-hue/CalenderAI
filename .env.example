# ─── CalenderAI Environment Variables ───
# Copy this file to .env and fill in your API key.
# NEVER commit .env to version control.

# Google Gemini API Key (server-side only — used in netlify/functions/ai-planner.ts)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the default Gemini model (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
